# Vorlage für den Blog-Build. Kopieren nach .env (wird von Git ignoriert) und ausfüllen:
#   cp .env.example .env && chmod 600 .env
# Gelesen von scripts/blog-daten.mjs über `node --env-file-if-exists=.env`.

# Basis-URL des Strapi-CMS (ohne /api). Standard, wenn leer: https://cms.ozan-orhan.com
STRAPI_URL=https://cms.ozan-orhan.com

# Read-only API-Token aus Strapi (Settings → API Tokens → Token type "Read-only"
# oder "Custom" mit nur find/findOne auf "article"). Niemals committen oder teilen.
STRAPI_TOKEN=
